<?xml version="1.0"?>
<!--
  arm_6dof_standalone.urdf

  Same 6-DOF arm as in agent_with_arm.urdf (waist/shoulder/elbow +
  spherical wrist, d2/a2/d4/d6 per the DH diagram), but as its OWN
  body with a fixed base -- not attached to the trolley via a movable
  joint. agent_arm_robot.py repositions this body's base each time the
  trolley moves (p.resetBasePositionAndOrientation) so it "rides
  along", and solves inverse kinematics against ONLY these 6 joints.

  This split exists because pybullet's calculateInverseKinematics
  treats lowerLimits/upperLimits as a soft null-space bias, not a hard
  constraint -- pinning the trolley's prismatic joints to a zero range
  in a combined URDF did not actually stop the solver from moving them,
  which produced arm angles solved for a trolley position that wasn't
  the one actually being used. A separate body with no prismatic joints
  in its kinematic tree at all sidesteps that quirk entirely rather
  than fighting it.
-->
<robot name="arm_6dof_standalone">

  <material name="arm_teal"><color rgba="0.10 0.55 0.55 1"/></material>
  <material name="arm_grey"><color rgba="0.55 0.55 0.58 1"/></material>
  <material name="wrist_dark"><color rgba="0.25 0.25 0.28 1"/></material>
  <material name="tool_dark"><color rgba="0.05 0.05 0.05 1"/></material>

  <link name="arm_base_link">
    <visual><geometry><box size="0.05 0.05 0.02"/></geometry><material name="arm_grey"/></visual>
    <inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>

  <link name="arm_link1">
    <visual><geometry><cylinder radius="0.045" length="0.08"/></geometry><material name="arm_teal"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.08"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="arm_joint1" type="revolute">
    <parent link="arm_base_link"/><child link="arm_link1"/>
    <origin xyz="0 0 -0.09" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="1.5"/>
    <dynamics damping="2.0" friction="0.5"/>
  </joint>

  <link name="arm_link2">
    <visual><origin xyz="0.5 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.035" length="1.0"/></geometry><material name="arm_grey"/></visual>
    <collision><origin xyz="0.5 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.035" length="1.0"/></geometry></collision>
    <inertial><origin xyz="0.5 0 0"/><mass value="0.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/></inertial>
  </link>

  <joint name="arm_joint2" type="revolute">
    <parent link="arm_link1"/><child link="arm_link2"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" effort="200" velocity="1.2"/>
    <dynamics damping="3.0" friction="0.8"/>
  </joint>

  <link name="arm_link3">
    <visual><origin xyz="0.5 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="1.0"/></geometry><material name="arm_grey"/></visual>
    <collision><origin xyz="0.5 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="1.0"/></geometry></collision>
    <inertial><origin xyz="0.5 0 0"/><mass value="0.6"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.06"/></inertial>
  </link>

  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/><child link="arm_link3"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.15" upper="3.15" effort="150" velocity="1.2"/>
    <dynamics damping="2.5" friction="0.6"/>
  </joint>

  <link name="arm_link4">
    <visual><geometry><cylinder radius="0.025" length="0.06"/></geometry><material name="wrist_dark"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.06"/></geometry></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="arm_joint4" type="revolute">
    <parent link="arm_link3"/><child link="arm_link4"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="60" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.3"/>
  </joint>

  <link name="arm_link5">
    <visual><geometry><cylinder radius="0.022" length="0.05"/></geometry><material name="wrist_dark"/></visual>
    <collision><geometry><cylinder radius="0.022" length="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>

  <joint name="arm_joint5" type="revolute">
    <parent link="arm_link4"/><child link="arm_link5"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="60" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.3"/>
  </joint>

  <link name="arm_link6">
    <visual><geometry><cylinder radius="0.02" length="0.04"/></geometry><material name="wrist_dark"/></visual>
    <collision><geometry><cylinder radius="0.02" length="0.04"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>

  <joint name="arm_joint6" type="revolute">
    <parent link="arm_link5"/><child link="arm_link6"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="40" velocity="2.5"/>
    <dynamics damping="0.8" friction="0.2"/>
  </joint>

  <link name="tool_link">
    <visual><geometry><cylinder radius="0.025" length="0.05"/></geometry><material name="tool_dark"/></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="arm_link6"/><child link="tool_link"/>
    <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
  </joint>

</robot>
