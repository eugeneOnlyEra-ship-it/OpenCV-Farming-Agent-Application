{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FarmTableReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/FarmPods",
        "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/FarmPods/index/*"
      ]
    }
  ]
}
